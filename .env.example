# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL="postgresql://juan:juan_dev_password@localhost:5432/juan_p2p?schema=public"

# --- Redis (rate limiting, 2FA pendiente, anti-replay TOTP) ---
REDIS_URL="redis://localhost:6379"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="CAMBIAR_POR_32_BYTES_BASE64"

# --- Cifrado AES-256-GCM (chat y secretos 2FA en reposo) ---
# 32 bytes en base64. Generar igual que NEXTAUTH_SECRET. NO reutilizar el mismo valor.
ENCRYPTION_MASTER_KEY="CAMBIAR_POR_OTROS_32_BYTES_BASE64"

# --- Negocio ---
COMMISSION_RATE="0.008"
PAYMENT_WINDOW_MINUTES="30"
# Cada cuánto corre el job que cancela trades vencidos y devuelve el locked al vendedor.
EXPIRE_JOB_INTERVAL_MS="30000"

# --- Comprobantes de pago (fuera de /public, se sirven con control de acceso) ---
STORAGE_DIR="./storage"

PORT=3000
